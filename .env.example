# Gemini (Google AI Studio) API key
# Get yours at https://Gemini (Google AI Studio).ai/keys
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# SQLite database path (optional, defaults shown)
SQLITE_DB_PATH=/app/data/vanguard.db

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
